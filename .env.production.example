# Produção — use com EasyPanel (Compose) ou: docker compose -f docker-compose.prod.yml up -d
#
# Copie para .env.production e preencha antes do deploy.

# --- URLs públicas (domínios EasyPanel) ---
FRONTEND_URL=https://app.seudominio.com
API_PUBLIC_URL=https://api.seudominio.com

# --- Supabase (mesmo projeto dev/prod ou projeto dedicado prod) ---
SUPABASE_URL=https://SEU_PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=https://SEU_PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Segurança API (mesmo valor no frontend e backend) ---
API_SECRET=gere-uma-chave-longa-aleatoria

# --- Frontend build (URL pública da API — usada no browser se necessário) ---
NEXT_PUBLIC_API_URL=https://api.seudominio.com

# --- CORS backend (origem do frontend) ---
CORS_ORIGINS=https://app.seudominio.com

# --- LLM (opcional; sem chave usa fallback regex) ---
LLM_PROVIDER=auto
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- PMG e-mail / WhatsApp (opcional) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
