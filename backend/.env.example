# Supabase
SUPABASE_URL=https://lhonsqzmbfshsircebym.supabase.co
SUPABASE_SERVICE_ROLE_KEY=COLE_AQUI_A_SECRET_KEY

# Segurança — mesmo valor em frontend (.env.local) e produção
API_SECRET=change-me

# CORS — em produção: https://app.seudominio.com (vírgula para múltiplos)
CORS_ORIGINS=http://localhost:3000

# IA — classificação de lançamentos (Anthropic Claude)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Alternativas (se LLM_PROVIDER=auto, ordem: anthropic → gemini → groq → openai)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# E-mail (SMTP)
# O destinatário do PMG pode ser qualquer e-mail (@gmail, @outlook, @yahoo, corporativo…).
# Escolha SMTP_HOST conforme a conta que ENVIA:
#   Gmail:   smtp.gmail.com:587 + senha de app
#   Outlook: smtp.office365.com:587
#   Yahoo:   smtp.mail.yahoo.com:587 + senha de app
#   Zoho:    smtp.zoho.com:587
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_FROM=acc-nomad@seudominio.com

# WhatsApp — Evolution API, Z-API ou webhook genérico
WHATSAPP_PROVIDER=generic
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
